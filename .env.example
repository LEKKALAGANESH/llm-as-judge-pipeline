# ===========================================================================
# llm-as-judge-pipeline - environment template
#
#     cp .env.example .env
#
# .env is gitignored; this template is committed. Never commit real keys.
# ===========================================================================
#
# ###########################################################################
# #                                                                         #
# #  >>> REQUIRED KEYS <<<  Fill these two in. Everything else has a        #
# #                         working default in config/suite_config.yaml.    #
# #                                                                         #
# #      1. GROQ_API_KEY     -> https://console.groq.com/keys               #
# #      2. GEMINI_API_KEY   -> https://aistudio.google.com/apikey          #
# #                                                                         #
# #  Both are free tier and neither requires a card.                        #
# #                                                                         #
# ###########################################################################
#
# WHAT RUNS WITH NO KEY AT ALL:
#   - the full test suite:  python -m pytest        (200 tests, offline)
#   - every aggregation, statistic and report-rendering path
#   - `python main.py replay <run_id>`, which rebuilds a committed report
#     from the audit log alone
#
# WHAT NEEDS A KEY:
#   - any live judging: run-suite, compare-configs, validate-judge,
#     run-ablation, measure-self-enhancement
#
# Check both providers before spending anything:  python main.py smoke-test

# ---------------------------------------------------------------------------
# REQUIRED 1/2 - the judge, and the candidate generators
#
# Groq serves BOTH the judge (llama-3.3-70b-versatile, Meta lineage) and the
# candidate outputs (openai/gpt-oss-*, OpenAI lineage). Same provider, different
# model families -- which is the point: the cross-family invariant is about
# model LINEAGE, not about who serves it, and `derive_family` reads the model
# portion rather than the routing prefix so this cannot be fudged.
#   https://console.groq.com/keys
# ---------------------------------------------------------------------------
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# REQUIRED 2/2 - cross-family alternate and the self-enhancement comparison
#
#   https://aistudio.google.com/apikey
#
# Measured limit: the Gemini free tier meters gemini-3.5-flash at 20 requests
# per DAY (GenerateRequestsPerDayPerProjectPerModel-FreeTier). Google does not
# publish this figure; it came out of this pipeline's own audit log. Against a
# validation suite needing ~370 calls that is ~19 days per run, which is why
# the judge is a Groq-hosted model and Gemini is the alternate.
#
# Free-tier data policy: Google states free-tier content may be used to improve
# Google products and read by human reviewers. Do not route confidential data
# through this pipeline. The free tier is unavailable in the EEA, Switzerland
# and the UK.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# --- OPTIONAL: nonce salt for prompt-injection defence ---------------------
# Overrides the per-request content nonce delimiter. Must be a real process
# environment variable -- it is read at module import, before .env is loaded.
# JUDGE_NONCE_SALT=
